{
  "update_channel": "stable",
  "statusLine": { "context": true, "session": true, "workspace": true },
  "theme": "catppuccin-mocha",
  "provider": "codex",
  "models": { "codex": "gpt-6-luna" },
  "effort": "high",
  "fast_mode": false,
  "fast_mode_model_bound": true,
  "ultrafast_mode": false,
  "notifications": {
    "turn_end": false,
    "attention_required": true,
    "max": false
  },
  "permission_mode": "ask",
  "permission": {
    "*": "allow",
    "delete_file": { "*": "ask" },
    "bash": {
      "*": "allow",
      "git add *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "rm *": "ask"
    }
  }
}
